# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/pazysalvo_sena

# Clave secreta para firmar los tokens JWT
JWT_SECRET=secreto_super_seguro_pazysalvo_2026

# Credenciales del correo (Nodemailer - Gmail requiere "contraseña de aplicación")
EMAIL_USER=
EMAIL_PASS=

# URL del frontend (usada en el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Origen permitido para CORS (lista blanca, separada por comas)
CORS_ORIGIN=http://localhost:3000

# Límite de peticiones por ventana para el login (protección contra fuerza bruta)
RATE_LIMIT_MAX=10

# Seed del Administrador inicial (opcional)
SEED_ADMIN_NOMBRE=Administrador General
SEED_ADMIN_EMAIL=admin@institucion.edu.co
SEED_ADMIN_PASSWORD=AdminSeguro123!
